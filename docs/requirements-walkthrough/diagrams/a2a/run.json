  "cards": [
    {
      "dot": "emerald",
      "title": "执行与交付是两个边界",
      "items": [
        "执行结算结束释放容量；交付确认不占运行容量",
        "服务端落盘后才确认；WSS 发送成功不代表已交付"
      ]
    },
    {
      "dot": "cyan",
      "title": "标准任务流",
      "items": [
        "使用 SendStreamingMessage 省去额外订阅往返",
        "也可 SendMessage 后 SubscribeToTask；执行不依赖订阅存在"
      ]
    }
  ],
