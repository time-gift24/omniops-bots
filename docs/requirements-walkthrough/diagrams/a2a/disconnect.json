      "label": "读取持久终态与 Artifact"
    },
    {
      "id": "disconnect-m8",
      "from": "disk",
      "to": "a2a",
      "y": 527,
      "label": "返回原结果"
    },
    {
      "id": "disconnect-m9",
      "from": "a2a",
      "to": "server",
      "y": 573,
      "label": "返回当前 Task 与结果"
    },
    {
      "id": "disconnect-m10",
      "from": "server",
      "to": "a2a",
      "y": 619,
      "label": "持久保存后确认交付"
    },
    {
      "id": "disconnect-m11",
      "from": "a2a",
      "to": "disk",
      "y": 665,
      "label": "标记原结果已交付"
    }
