  "cards": [
    {
      "dot": "cyan",
      "title": "本图前提",
      "items": [
        "本例在重连前已完成，因此使用 GetTask",
        "若仍未终态则 SubscribeToTask；首条为当前快照"
      ]
    },
    {
      "dot": "emerald",
      "title": "恢复交付，不恢复执行",
      "items": [
        "订阅时若已终态，转为 GetTask；不回放历史事件",
        "省略 WSS 重连细节；不新增私有恢复消息"
      ]
    }
  ],
  "meta": {
