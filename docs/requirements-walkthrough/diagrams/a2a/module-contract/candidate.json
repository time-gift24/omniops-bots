  "cards": [
    {
      "dot": "cyan",
      "title": "先验证模块，再作为黑盒接入",
      "items": [
        "独立外部 Agent → SDK 标准 HTTP JSON-RPC／SSE → 本模块 → 真实 runtime；WSS 后接。",
        "本图表示已实现的模块公开契约，省略参数与非关键成员；完整定义见 OpenSpec contract.md。"
      ]
    },
    {
      "dot": "emerald",
      "title": "复用 SDK 实现，只补已确认差异",
      "items": [
        "发送两方法及取消做适配；其余标准操作沿用 DefaultRequestHandler，薄桥接使用 SDK AgentExecutor。",
        "事件合并用 ResultManager；受控 TaskStore 写入调用 DatabaseTaskStore(trx)，SDK Task 表加一张项目扩展表。"
      ]
    },
    {
      "dot": "amber",
      "title": "业务 JSON 与生命周期留在明确边界",
      "items": [
        "execute 输入：threadId／runId、固定 agentId／contentId、JSON 对象；输出：ExecutionOutcome<JsonValue>。",
        "A2AService → runtime 是同进程函数；Task／Message／socket 不传入执行。只结束等待不取消 Task。"
      ]
    }
  ]
