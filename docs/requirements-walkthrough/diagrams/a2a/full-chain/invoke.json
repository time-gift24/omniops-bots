  ],
  "segments": [
    {
      "from": 145,
      "to": 580,
      "label": "① 固定版本并持久记录调用"
    },
    {
      "from": 585,
      "to": 1595,
      "label": "② 标准 A2A 受理与独立执行"
    },
    {
      "from": 1605,
      "to": 2385,
      "label": "③ 持久保存结果与明确确认交付"
    },
    {
      "from": 2400,
      "to": 2720,
      "label": "④ 持久结果驱动原服务端图"
    }
  ],
  "messages": [
    {
      "id": "chain-1",
      "from": "graph",
      "to": "catalog",
      "y": 175,
      "label": "选择 agentId＋contentId",
      "note": "固定目标安装与授权入口；调用期间不跟随浮动最新版"
    },
    {
      "id": "chain-2",
      "from": "catalog",
      "to": "graph",
      "y": 265,
      "label": "返回标准 AgentCard",
      "note": "取 supportedInterfaces 的 tenant、绑定与协议版本",
      "variant": "return"
    },
    {
      "id": "chain-3",
      "from": "graph",
      "to": "pg",
      "y": 355,
      "label": "持久保存本次调用意图",
      "note": "serverRunId／步骤、安装、确定版本、messageId、显式输入与上下文"
    },
    {
      "id": "chain-4",
      "from": "pg",
      "to": "graph",
      "y": 445,
      "label": "调用意图提交成功",
      "variant": "return"
    },
    {
      "id": "chain-5",
      "from": "graph",
      "to": "client",
      "y": 489,
      "label": "唤醒待发送调用",
      "note": "Redis 只作通知；漏发从 PG 待发送记录对账补齐"
    },
    {
      "id": "chain-6",
      "from": "client",
      "to": "pg",
      "y": 615,
      "label": "读取原调用意图"
    },
    {
      "id": "chain-7",
      "from": "pg",
      "to": "client",
      "y": 659,
      "label": "返回原版本与 messageId",
      "variant": "return"
    },
    {
      "id": "chain-8",
      "from": "client",
      "to": "wire",
      "y": 703,
      "label": "SendStreamingMessage",
      "note": "标准 Message 的 Data Part 携带输入；contextId 只关联业务"
    },
    {
      "id": "chain-9",
      "from": "wire",
      "to": "task",
      "y": 793,
      "label": "转交原 JSON-RPC",
      "note": "按 tenant 校验确定入口与授权；WSS 不处理任务语义"
    },
    {
      "id": "chain-10",
      "from": "task",
      "to": "local",
      "y": 883,
      "label": "提交 SUBMITTED 与去重映射",
      "note": "原子预留容量，执行前落盘；同消息返回原 Task，不再次执行"
    },
    {
      "id": "chain-11",
      "from": "local",
      "to": "task",
      "y": 973,
      "label": "受理已持久提交",
      "variant": "return"
    },
    {
      "id": "chain-12",
      "from": "task",
      "to": "wire",
      "y": 1017,
      "label": "首条 Task（含 taskId）",
      "variant": "return"
    },
    {
      "id": "chain-13",
      "from": "wire",
      "to": "client",
      "y": 1061,
      "label": "转交已受理 Task",
      "variant": "return"
    },
    {
      "id": "chain-14",
      "from": "client",
      "to": "pg",
      "y": 1105,
      "label": "绑定 messageId → taskId"
    },
    {
      "id": "chain-15",
      "from": "task",
      "to": "runtime",
      "y": 1149,
      "label": "启动确定版本与本轮输入",
      "note": "独立创建 thread、run、graphThreadId 和 Chrome 页面；profile 复用登录态"
    },
    {
      "id": "chain-16",
      "from": "runtime",
      "to": "local",
      "y": 1239,
      "label": "读取确定 Agent／Skill 包",
      "note": "校验 agent.json、prompt.md 与明确引用的完整 Skill 包"
    },
    {
      "id": "chain-17",
      "from": "local",
      "to": "runtime",
      "y": 1329,
      "label": "返回固定物料快照",
      "note": "装配本机模型、工具／MCP；Prompt 与只读 Skill 交给执行图节点",
      "variant": "return"
    },
    {
      "id": "chain-18",
      "from": "task",
      "to": "wire",
      "y": 1419,
      "label": "Task 状态事件：WORKING"
    },
    {
      "id": "chain-19",
      "from": "wire",
      "to": "client",
      "y": 1463,
      "label": "转交当前状态",
      "variant": "return"
    },
    {
      "id": "chain-20",
      "from": "runtime",
      "to": "task",
      "y": 1507,
      "label": "完成执行并排空资源",
      "note": "模型、MCP、Chrome 由执行层调用；一次执行到终态，证据留本地",
      "variant": "return"
    },
    {
      "id": "chain-21",
      "from": "task",
      "to": "local",
      "y": 1635,
      "label": "提交终态 Task／Artifact／记录",
