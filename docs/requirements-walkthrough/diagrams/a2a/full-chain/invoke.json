{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "目标完整链路 · 服务端 graph 节点经 A2A 调用桌面 Agent",
    "locale": "zh-CN",
    "output": "docs/requirements-walkthrough/diagrams/a2a/full-chain/invoke.html",
