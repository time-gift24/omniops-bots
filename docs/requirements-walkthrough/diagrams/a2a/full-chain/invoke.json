    },
    {
      "id": "chain-22",
      "from": "local",
      "to": "task",
      "y": 1725,
      "label": "终态已落盘，完成结算",
      "note": "此时释放运行容量；等待交付确认不再占用运行槽",
      "variant": "return"
    },
    {
      "id": "chain-23",
      "from": "task",
      "to": "wire",
      "y": 1815,
      "label": "最终 Artifact → COMPLETED",
      "variant": "return"
    },
    {
      "id": "chain-24",
      "from": "wire",
      "to": "client",
      "y": 1859,
      "label": "转交不可变终态与摘要",
      "variant": "return"
    },
    {
      "id": "chain-25",
      "from": "client",
      "to": "pg",
      "y": 1903,
      "label": "事务保存结果与待推进记录",
      "note": "保存原 Task／结果索引；附件先持久接收并建立授权索引"
    },
    {
      "id": "chain-26",
