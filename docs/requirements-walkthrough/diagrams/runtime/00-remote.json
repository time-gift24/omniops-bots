{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "服务端 Agent 以任务调用客户端 Agent",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [
      1080,
      640
    ]
  },
  "participants": [
    {
      "id": "server",
      "label": "服务端 Agent",
      "type": "backend",
      "sublabel": "任务编排"
    },
    {
      "id": "client",
      "label": "客户端 Agent",
      "type": "frontend",
      "sublabel": "后台执行"
    },
    {
      "id": "chrome",
      "label": "专用 Chrome",
      "type": "external"
    },
    {
      "id": "record",
      "label": "本地记录",
      "type": "database"
    }
  ],
  "messages": [
    {
      "id": "m-00-remote-0",
      "from": "server",
      "to": "client",
      "y": 180,
      "label": "WS 任务调用：ID、版本、上下文",
      "variant": "emphasis"
    },
    {
      "id": "m-00-remote-1",
      "from": "client",
      "to": "record",
      "y": 247,
      "label": "固定装配，创建独立会话",
      "variant": "default"
    },
    {
      "id": "m-00-remote-2",
      "from": "client",
      "to": "chrome",
      "y": 313,
      "label": "容量可用，绑定本会话页面执行",
      "variant": "emphasis"
    },
    {
      "id": "m-00-remote-3",
      "from": "chrome",
      "to": "client",
      "y": 380,
      "label": "返回操作结果",
      "variant": "return"
    },
    {
      "id": "m-00-remote-4",
      "from": "client",
      "to": "record",
      "y": 447,
      "label": "保存最终结果与运行快照",
      "variant": "default"
    },
    {
      "id": "m-00-remote-5",
      "from": "client",
      "to": "server",
      "y": 513,
      "label": "WS：状态、结果、快照",
      "variant": "emphasis"
    },
    {
      "id": "m-00-remote-6",
      "from": "server",
      "to": "client",
      "y": 550,
      "label": "确认收到该调用结果",
      "variant": "return"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "日常后台执行",
      "items": [
        "线上客户端只展示连接等基础状态",
        "逐条过程仅在运维调试桌面查看"
      ]
    },
    {
      "dot": "cyan",
      "title": "Console 查看任务结果",
      "items": [
        "结果持久化后回传服务端",
        "确认前保留记录，重连或重启后补传"
      ]
    }
  ]
}
