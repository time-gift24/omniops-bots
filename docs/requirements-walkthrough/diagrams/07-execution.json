{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "任务生命周期：执行与结果交付",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "viewBox": [
      980,
      566
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "调用与交付"
    },
    {
      "id": "execution-stop",
      "label": "停止执行"
    },
    {
      "id": "terminal",
      "label": "重启处理"
    }
  ],
  "states": [
    {
      "id": "call-received",
      "type": "start",
      "label": "接收服务端任务",
      "sublabel": "服务端 Agent · 调用 ID",
      "lane": "main",
      "col": 0,
      "step": "01"
    },
    {
      "id": "assembly-ready",
      "type": "active",
      "label": "装配就绪",
      "sublabel": "核对版本与内置工具",
      "lane": "main",
      "col": 1,
      "step": "02"
    },
    {
      "id": "chrome-running",
      "type": "active",
      "label": "绑定页面执行",
      "sublabel": "不同会话可以并发",
      "lane": "main",
      "col": 2,
      "step": "03"
    },
    {
      "id": "result-pending",
      "type": "waiting",
      "label": "结果待确认",
      "sublabel": "结果与快照已存本地",
      "lane": "main",
      "col": 3,
      "step": "04"
    },
    {
      "id": "result-acknowledged",
      "type": "success",
      "label": "交付完成",
      "sublabel": "服务端确认 · Console 展示",
      "lane": "main",
      "col": 4,
      "step": "05"
    },
    {
      "id": "execution-stopped",
      "type": "failure",
      "label": "停止后续步骤",
      "sublabel": "已完成操作不回滚",
      "lane": "execution-stop",
      "col": 0
    },
    {
      "id": "process-restarted",
      "type": "external",
      "label": "客户端重启",
      "sublabel": "检查本地执行记录",
      "lane": "terminal",
      "col": 0,
      "yOffset": -66
    },
    {
      "id": "interrupted-unknown",
      "type": "failure",
      "label": "中断 · 结果未知",
      "sublabel": "保留记录 · 回报服务端",
      "lane": "terminal",
      "col": 2,
      "yOffset": -66
    }
  ],
  "transitions": [
    {
      "id": "stop-request",
      "from": "chrome-running",
      "to": "execution-stopped",
      "label": "取消 / 超时",
      "variant": "security",
      "labelDy": 24
    },
    {
      "id": "stop-result",
      "from": "execution-stopped",
      "to": "result-pending",
      "label": "保存终止结果",
      "variant": "default"
    },
    {
      "id": "unfinished-on-restart",
      "from": "process-restarted",
      "to": "interrupted-unknown",
      "label": "原任务未完成",
      "variant": "security"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "后台执行与运维调试",
      "items": [
        "每会话固定页面；不同会话并发，默认最多 4 轮。",
        "逐条过程留在运维调试桌面，线上用户操作 Console。"
      ]
    },
    {
      "dot": "amber",
      "title": "断线只影响交付",
      "items": [
        "WebSocket 断线后退避重连，当前任务继续执行。",
        "确认前保留结果；按原调用 ID 补传，不重新执行。"
      ]
    },
    {
      "dot": "rose",
      "title": "重启后不续跑",
      "items": [
        "中断未知交给服务端 Agent，Console 展示后续状态。",
        "任务运行时阻止正常退出；取消、超时均不自动重试。"
      ]
    }
  ]
}
