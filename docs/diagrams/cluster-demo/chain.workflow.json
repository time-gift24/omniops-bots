      "width": 180,
      "height": 84
    },
    {
      "id": "render",
      "lane": "execution",
      "col": 2,
      "type": "backend",
      "label": "render",
      "sublabel": "usize: 5",
      "tag": "Δ output = len=5",
      "width": 180,
      "height": 84
    },
    {
      "id": "completed",
      "lane": "result",
      "col": 5,
      "type": "external",
      "label": "Completed",
      "sublabel": "Run 终态 · exit 0",
      "width": 180,
      "height": 84
    }
  ],
  "edges": [
    {
      "id": "count-render",
      "from": "count",
      "to": "render",
      "label": "Goto · 5",
      "variant": "emphasis"
