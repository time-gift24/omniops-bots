{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.beui.tsbuildinfo",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "resolveJsonModule": true,
    "paths": {
      "@beui-template/*": ["./vendor/beui-templates/*"]
    }
  },
  "include": ["vendor/beui-templates/**/*.ts", "vendor/beui-templates/**/*.tsx"]
}
